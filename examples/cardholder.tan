version: 1
unit: mm
defaults:
  leather: veg-tan
  thickness: 2
  stitch:
    inset: 3.5
    spacing: 3.5
    hole: 1
    style: cross
    color: "#e8d4a0"

leathers:
  veg-tan:
    front: { roughness: 0.35, grain: fine }
    back: { roughness: 0.8, grain: suede }
    color: "#6b3a2a"

# ISO ID-1 card 85.6×54. Pocket 88×56. Bottom and side walls 10mm (~8–10 cards).
# Top wall 12mm: same pocket plus one leather thickness, because it wraps outside the front.
pieces:
  - id: body
    side: front
    outline:
      path:
        d: >-
          M 108 49
          L 108 103
          L 98 103
          L 98 104
          L 98 114
          L 98 170
          L 10 170
          L 10 114
          L 10 104
          L 10 103
          L 0 103
          L 0 49
          L 10 49
          L 10 48
          L 10 36
          L 10 18
          L 25.07 2.93
          A 10 10 0 0 1 32.14 0
          L 75.86 0
          A 10 10 0 0 1 82.93 2.93
          L 98 18
          L 98 36
          L 98 48
          L 98 49
          Z
    # Vertical seam: flap outer longs meet underFront sides after the walls fold.
    # t=0 is the underBack-adjacent corner on each edge so holes pair when folded.
    stitch:
      - style: cross
        start: 3.5
        edges:
          - { from: [3.5, 99.5], to: [3.5, 52.5] }
          - { from: [13.5, 117.5], to: [13.5, 166.5] }
      - style: cross
        start: 3.5
        edges:
          - { from: [104.5, 99.5], to: [104.5, 52.5] }
          - { from: [94.5, 117.5], to: [94.5, 166.5] }
    folds:
      - id: overBack
        from: [10, 48]
        to: [98, 48]
        angle: 90
        hinge: valley
      - id: lid
        from: [10, 36]
        to: [98, 36]
        angle: 90
        hinge: valley
      - id: underBack
        from: [10, 104]
        to: [98, 104]
        angle: 90
        hinge: valley
      - id: underFront
        from: [10, 114]
        to: [98, 114]
        angle: 90
        hinge: valley
      - id: left
        from: [10, 49]
        to: [10, 103]
        angle: 90
        hinge: valley
      - id: right
        from: [98, 49]
        to: [98, 103]
        angle: 90
        hinge: valley
    hardware:
      - type: snap
        at: [54, 14]
    motion:
      - id: overBack
        folds: { overBack: 90 }
      - id: lid
        folds: { lid: 90 }
      - id: underBack
        folds: { underBack: 90 }
      - id: underFront
        folds: { underFront: 90 }
      - id: left
        folds: { left: 90 }
      - id: right
        folds: { right: 90 }

layout:
  paper: A4
  margin: 10
  placements:
    - piece: body
      x: 15
      y: 15
      rotate: 0

assembly: []
